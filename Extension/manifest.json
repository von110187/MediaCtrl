{
    "manifest_version": 3,
    "name": "MediaCtrl",
    "version": "2.0",
    "description": "Reports video page state to MediaCtrl (AutoHotkey) and runs its fullscreen/seek/speed commands.",
    "permissions": ["tabs", "alarms", "storage"],
    "host_permissions": ["<all_urls>"],
    "background": { "service_worker": "background.js" },
    "content_scripts": [
        {
            "matches": ["*://*/*"],
            "js": ["lib/pageLogic.js", "content.js"],
            "run_at": "document_idle",
            "all_frames": false
        }
    ]
}
